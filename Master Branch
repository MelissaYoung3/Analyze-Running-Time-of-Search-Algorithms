#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <ctime>
using namespace std;

// Recursive Binary Search
int recursiveBinarySearch(const vector<int>& arr, int target, int low, int high) {
    if (low <= high) {
        int mid = low + (high - low) / 2;
        if (arr[mid] == target) {
            return mid; // Target found
        } else if (arr[mid] < target) {
            return recursiveBinarySearch(arr, target, mid + 1, high);
        } else {
            return recursiveBinarySearch(arr, target, low, mid - 1);
        }
    }
    return -1; // Target not found
}

// Iterative Binary Search
int iterativeBinarySearch(const vector<int>& arr, int target) {
    int low = 0;
    int high = arr.size() - 1;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        if (arr[mid] == target) {
            return mid; // Target found
        } else if (arr[mid] < target) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    return -1; // Target not found
}

// Sequential Search
int sequentialSearch(const vector<int>& arr, int target) {
    for (int i = 0; i < arr.size(); ++i) {
        if (arr[i] == target) {
            return i; // Target found
        }
    }
    return -1; // Target not found
}

int main() {
    srand(time(0)); // Seed for random number generation
    vector<int> arr;

    // Fill vector with random numbers in range 1-100
    for (int i = 0; i < 10; ++i) {
        arr.push_back(rand() % 100 + 1);
    }

    // Sort the vector before performing binary search
    sort(arr.begin(), arr.end());

    // Print contents of the vector
    cout << "Vector contents: ";
    for (int num : arr) {
        cout << num << " ";
    }
    cout << endl;

    // Select a target that exists in the array
    int target1 = arr[rand() % arr.size()];
    // Generate a target that may not exist
    int target2 = rand() % 100 + 1;
    cout << "Target 1 (guaranteed in array): " << target1 << endl;
    cout << "Target 2 (randomly chosen): " << target2 << endl;

    // Recursive Binary Search
    int result = recursiveBinarySearch(arr, target1, 0, arr.size() - 1);
    if (result != -1) {
        cout << "Recursive Binary Search: " << target1 << " found at location " << result << endl;
    } else {
        cout << "Recursive Binary Search: " << target1 << " was not found" << endl;
    }

    // Iterative Binary Search
    result = iterativeBinarySearch(arr, target1);
    if (result != -1) {
        cout << "Iterative Binary Search: " << target1 << " found at location " << result << endl;
    } else {
        cout << "Iterative Binary Search: " << target1 << " was not found" << endl;
    }

    // Sequential Search
    result = sequentialSearch(arr, target1);
    if (result != -1) {
        cout << "Sequential Search: " << target1 << " found at location " << result << endl;
    } else {
        cout << "Sequential Search: " << target1 << " was not found" << endl;
    }

    // Test with target2
    result = recursiveBinarySearch(arr, target2, 0, arr.size() - 1);
    if (result != -1) {
        cout << "Recursive Binary Search: " << target2 << " found at location " << result << endl;
    } else {
        cout << "Recursive Binary Search: " << target2 << " was not found" << endl;
    }

    result = iterativeBinarySearch(arr, target2);
    if (result != -1) {
        cout << "Iterative Binary Search: " << target2 << " found at location " << result << endl;
    } else {
        cout << "Iterative Binary Search: " << target2 << " was not found" << endl;
    }

    result = sequentialSearch(arr, target2);
    if (result != -1) {
        cout << "Sequential Search: " << target2 << " found at location " << result << endl;
    } else {
        cout << "Sequential Search: " << target2 << " was not found" << endl;
    }

    return 0;
}

